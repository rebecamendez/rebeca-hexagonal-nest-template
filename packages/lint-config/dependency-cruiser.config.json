{
  "forbidden": [
    {
      "name": "no-circular",
      "comment": "Circular dependencies are not allowed",
      "severity": "error",
      "from": {},
      "to": {
        "circular": true
      }
    },
    {
      "name": "no-orphans",
      "comment": "Modules should be used somewhere",
      "severity": "warn",
      "from": {
        "orphan": true,
        "pathNot": [
          "\\.spec\\.ts$",
          "\\.test\\.ts$",
          "index\\.ts$",
          "main\\.ts$"
        ]
      },
      "to": {}
    },
    {
      "name": "no-application-to-infrastructure",
      "comment": "Application depends on domain and ports only (dependency inversion)",
      "severity": "error",
      "from": {
        "path": "(^|/)modules/.+/application(/|$)",
        "pathNot": "\\.spec\\.ts$"
      },
      "to": {
        "path": "(^|/)modules/.+/infrastructure(/|$)"
      }
    },
    {
      "name": "no-application-to-presentation",
      "comment": "Application never reaches presentation",
      "severity": "error",
      "from": {
        "path": "(^|/)modules/.+/application(/|$)",
        "pathNot": "\\.spec\\.ts$"
      },
      "to": {
        "path": "(^|/)modules/.+/presentation(/|$)"
      }
    },
    {
      "name": "no-domain-to-outer-layers",
      "comment": "Domain stays pure: no application, infrastructure, or presentation",
      "severity": "error",
      "from": {
        "path": "(^|/)modules/.+/domain(/|$)",
        "pathNot": "\\.spec\\.ts$"
      },
      "to": {
        "path": "(^|/)modules/.+/(application|infrastructure|presentation)(/|$)"
      }
    },
    {
      "name": "no-presentation-to-infrastructure",
      "comment": "Presentation reaches application and domain, never infrastructure",
      "severity": "error",
      "from": {
        "path": "(^|/)modules/.+/presentation(/|$)",
        "pathNot": "\\.spec\\.ts$"
      },
      "to": {
        "path": "(^|/)modules/.+/infrastructure(/|$)"
      }
    },
    {
      "name": "no-infrastructure-to-presentation",
      "comment": "Infrastructure never reaches presentation",
      "severity": "error",
      "from": {
        "path": "(^|/)modules/.+/infrastructure(/|$)",
        "pathNot": "\\.spec\\.ts$"
      },
      "to": {
        "path": "(^|/)modules/.+/presentation(/|$)"
      }
    }
  ],
  "options": {
    "doNotFollow": {
      "path": "node_modules"
    },
    "tsConfig": {
      "fileName": "tsconfig.json"
    },
    "enhancedResolveOptions": {
      "exportsFields": [
        "exports"
      ],
      "conditionNames": [
        "import",
        "require",
        "node",
        "default"
      ]
    },
    "reporterOptions": {
      "dot": {
        "collapsePattern": "node_modules/[^/]+"
      },
      "archi": {
        "collapsePattern": "^(packages|src)/[^/]+|.*\\.d\\.ts$"
      }
    }
  }
}